body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #0b0f1a;
  color: white;
}

/* HEADER */
header {
  text-align: center;
  padding: 30px 10px;
  font-size: 28px;
  font-weight: bold;
  background: #11182a;
  border-bottom: 2px solid #1f2a44;
}

/* CONTAINER DAS FACÇÕES */
.container {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
  padding: 40px 20px;
}

/* CARD BASE */
.card {
  width: 280px;
  background: #141c2f;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 0 15px rgba(0,0,0,0.5);
  transition: 0.3s ease;
  cursor: pointer;
}

.card:hover {
  transform: scale(1.05);
}

/* IMAGEM DO CARD */
.card img {
  width: 100%;
  height: 160px;
  object-fit: cover;
}

/* TÍTULO */
.card h2 {
  text-align: center;
  margin: 15px 0 5px;
}

/* DESCRIÇÃO */
.card p {
  text-align: center;
  padding: 0 10px 20px;
  font-size: 14px;
  color: #bbb;
}

/* CORES DAS FACÇÕES */
.governo {
  border-top: 4px solid #2e6bff;
}

.revolucionario {
  border-top: 4px solid #ff3b3b;
}

.piratas {
  border-top: 4px solid #ffcc00;
}
